          <div className="inline-flex items-center gap-2 bg-gradient-to-r from-purple-500/10 to-blue-500/10 border border-blue-500/20 px-4 py-2 rounded-full text-xs font-semibold tracking-wider uppercase text-blue-400 backdrop-blur-md shadow-lg">
