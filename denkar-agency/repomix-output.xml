import React, { useRef, useMemo } from 'react';
import { Canvas, useFrame, extend } from '@react-three/fiber';
import { Effects } from '@react-three/drei';
import { UnrealBloomPass } from 'three-stdlib';
import * as THREE from 'three';
import { motion } from 'framer-motion';
import { ArrowRight, Code, Sparkles, Terminal } from 'lucide-react';
import { Link } from 'react-router-dom';

extend({ UnrealBloomPass });

// --- 3D PARTICLE SWARM ---
const ParticleSwarm = () => {
  const meshRef = useRef();
  const count = 3000; // Optimized for hero section
  
  const dummy = useMemo(() => new THREE.Object3D(), []);
  const target = useMemo(() => new THREE.Vector3(), []);
  const pColor = useMemo(() => new THREE.Color(), []);
  
  const positions = useMemo(() => {
    const pos = [];
    for (let i = 0; i < count; i++) {
      pos.push(new THREE.Vector3(
        (Math.random() - 0.5) * 40,
        (Math.random() - 0.5) * 30,
        (Math.random() - 0.5) * 40
      ));
    }
    return pos;
  }, []);

  const material = useMemo(() => new THREE.MeshBasicMaterial({ color: 0xffffff }), []);
  const geometry = useMemo(() => new THREE.TetrahedronGeometry(0.12), []);

  const PARAMS = useMemo(() => ({ pull: 0.15, chaos: 0.015, speed: 0.08 }), []);

  useFrame((state) => {
    if (!meshRef.current) return;
    const time = state.clock.elapsedTime;

    for (let i = 0; i < count; i++) {
      const { pull, chaos, speed } = PARAMS;
      const angle = i * 0.15 + time * speed;
      const baseRadius = 45;

      let x0 = Math.cos(angle) * baseRadius;
      let z0 = Math.sin(angle) * baseRadius;
      let y0 = (Math.random() - 0.5) * 12;

      const tiltX = Math.PI / 20;
      const tiltZ = Math.PI / 60;

      let x1 = x0 * Math.cos(tiltZ) - y0 * Math.sin(tiltZ);
      let y1 = x0 * Math.sin(tiltZ) + y0 * Math.cos(tiltZ);
      let yFinal = y1 * Math.cos(tiltX) - z0 * Math.sin(tiltX);
      let zFinal = y1 * Math.sin(tiltX) + z0 * Math.cos(tiltX);
      let xFinal = x1;

      xFinal += Math.sin(i * 8.98 + time * chaos) * 3;
      yFinal += Math.cos(i * 58.23 + time * chaos) * 3;
      zFinal += Math.sin(i * 35.16 + time * chaos) * 2;

      target.set(xFinal * (1 - pull), yFinal * (1 - pull), zFinal * (1 - pull));

      // Gradient from blue to purple
      const hue = 0.6 + (Math.sin(angle * 0.5) * 0.1);
      pColor.setHSL(hue, 0.9, 0.65);

      positions[i].lerp(target, 0.08);
      dummy.position.copy(positions[i]);
      dummy.updateMatrix();
      meshRef.current.setMatrixAt(i, dummy.matrix);
      meshRef.current.setColorAt(i, pColor);
    }
    meshRef.current.instanceMatrix.needsUpdate = true;
    if (meshRef.current.instanceColor) meshRef.current.instanceColor.needsUpdate = true;
  });

  return <instancedMesh ref={meshRef} args={[geometry, material, count]} />;
};

// --- 3D Particle Background Component ---
const ParticleBackground = () => {
  return (
    <div className="absolute inset-0 z-0 pointer-events-none overflow-hidden opacity-60" style={{ width: '100%', height: '100%' }}>
      <Canvas camera={{ position: [0, 0, 70], fov: 50 }} dpr={[1, 2]}>
        <ParticleSwarm />
        <Effects disableGamma>
          <unrealBloomPass threshold={0} strength={1.2} radius={0.5} />
        </Effects>
      </Canvas>
    </div>
  );
};

// Framer Motion Animation Variants
